# Server
PORT=3000
APP_ENV=development
HOST=0.0.0.0

# PostgreSQL
# Local dev
DATABASE_URL=postgresql://dycoders@localhost:5432/campusride?schema=public
# Docker
# DATABASE_URL=postgresql://campusride:campusride@localhost:5432/campusride?schema=public

# Auth (Phase 2 - keep placeholders until then)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# CORS (comma separated origins, * for all in dev)
CORS_ORIGINS=*

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info

# Ngrok (set to "true" to expose backend via ngrok for mobile dev)
NGROK_ENABLED=false
# NGROK_SUBDOMAIN=campusride